# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Single-user administrator access password
ADMIN_PASSWORD="your-strong-admin-password"

# Master Encryption Key (32 bytes or 64 hex chars) for zero-knowledge reference key logging
MASTER_ENCRYPTION_KEY="your-static-32-byte-master-encryption-key"

# Google Service Account Credentials JSON for resumable Google Drive uploads
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# (Optional) Specific Google Drive destination folder ID
DRIVE_FOLDER_ID=""

# Secret key for Flask sessions
FLASK_SECRET_KEY="generate-a-secure-random-secret-key"
